# Copy this file to .env and fill in values for local development.
# Never commit the real .env file.
#
# All variables are namespaced with CLINEVAL_ so that generic ambient
# environment variables (e.g. a system-wide DATABASE_URL) cannot silently
# override this application's configuration.

CLINEVAL_APP_ENV=development
CLINEVAL_LOG_LEVEL=INFO
CLINEVAL_RANDOM_SEED=42

# SQLite by default. Can be swapped for a PostgreSQL URL later without code changes
# to the data-access layer (see docs/ARCHITECTURE.md).
CLINEVAL_DATABASE_URL=sqlite:///./clineval.db

# Optional: only required if/when an LLM-as-judge evaluator or a model-under-test
# is configured to call a hosted API. Leave blank to run without any LLM calls.
CLINEVAL_LLM_API_KEY=
CLINEVAL_LLM_PROVIDER=

# --- Model providers (Phase 4) -----------------------------------------------
# All optional. With none set, the application runs fully offline using the
# deterministic mock provider, and no benchmark data leaves the machine.
# One variable per provider so several can be configured at once and none can
# accidentally pick up another's credential.

CLINEVAL_ANTHROPIC_API_KEY=
CLINEVAL_OPENAI_API_KEY=
CLINEVAL_GOOGLE_API_KEY=

# OpenAI-compatible local server (Ollama, vLLM, LM Studio), e.g.
# http://localhost:11434/v1
CLINEVAL_LOCAL_BASE_URL=

# Model names come from configuration, never hard-coded, because provider
# model identifiers change and a pinned name silently rots.
CLINEVAL_SUMMARIZER_MODEL=
CLINEVAL_JUDGE_MODEL=
