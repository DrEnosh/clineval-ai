# Copy this file to .env and fill in values for local development.
# Never commit the real .env file.
#
# All variables are namespaced with CLINEVAL_ so that generic ambient
# environment variables (e.g. a system-wide DATABASE_URL) cannot silently
# override this application's configuration.

CLINEVAL_APP_ENV=development
CLINEVAL_LOG_LEVEL=INFO
CLINEVAL_RANDOM_SEED=42

# SQLite by default. Can be swapped for a PostgreSQL URL later without code changes
# to the data-access layer (see docs/ARCHITECTURE.md).
CLINEVAL_DATABASE_URL=sqlite:///./clineval.db

# Optional: only required if/when an LLM-as-judge evaluator or a model-under-test
# is configured to call a hosted API. Leave blank to run without any LLM calls.
CLINEVAL_LLM_API_KEY=
CLINEVAL_LLM_PROVIDER=
